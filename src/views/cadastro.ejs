<%- include('partials/header') %>

<div class="container" style="min-width: 480px; width: 50vw;">
    <form method="post" action="/cadastro">
        <h1>Criar conta</h1>
        <label>
            E-mail
            <input name="email" type="text" placeholder="" class="input" autocomplete="off" required>
        </label>
        <label>
            Nome
            <input name="username" type="text" placeholder="" class="input" autocomplete="off" required>
        </label>
        <label>
            Senha
            <input name="password" type="password" placeholder="" class="input" autocomplete="off" required minlength="6">
        </label>

        <a href="/login" style="text-align: center; font-size: small;">Já tem uma conta? Acesse-a agora!</a>

        <button type="submit" class="button">Entrar</button>
    </form>
    <% if(locals.mensagem) { %>
        <span class="mensagem-erro"><%= mensagem %></span>
    <% } %>
</div>

<%- include('partials/footer') %>