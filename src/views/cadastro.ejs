<%- include('partials/header') %>

<div class="card-cadastro">
    <form method="post" action="/cadastro">
        <h1 class="title-cadastro"> s2 Cadastro do Mercadinho <3 </h1>
    
        <div class="input-box">
            <input type="text" placeholder="nome" autocomplete="off" required>
        </div>
        <div class="input-box">
            <input type="text" placeholder="email" autocomplete="off" required>
        </div>
        <div class="input-box">
            <input type="password" placeholder="senha" autocomplete="off" required minlength="6">
        </div>

        <div>
            <button type="submit" class="btn">cadastrar</button>
        </div>
    </form>
</div>

<%- include('partials/footer') %>