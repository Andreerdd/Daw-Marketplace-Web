<%- include('partials/header') %>

<div class="card-cadastro">
    <form method="post" action="/cadastro">
        <h1 class="title-cadastro"> s2 Cadastro do Mercadinho <3 </h1>
    
        <div class="input-box">
            <input type="text" name="username" placeholder="nome" class="form-control mb-2" autocomplete="off" required>
        </div>
        <div class="input-box">
            <input type="text" name="email" placeholder="email" class="form-control mb-2" autocomplete="off" required>
        </div>
        <div class="input-box">
            <input type="password" name="password" placeholder="senha" class="form-control mb-2" autocomplete="off" required minlength="6">
        </div>

        <div>
            <button type="submit" class="btn btn-primary">cadastrar</button>
        </div>
    </form>
</div>

<%- include('partials/footer') %>