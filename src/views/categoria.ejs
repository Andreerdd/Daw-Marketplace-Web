<%- include('partials/header') %>

<div class="container" style="min-width: 640px; width: 75vw; min-height: 60vh;">
    <div style="display: flex; flex-direction: column; justify-content: flex-start; align-items: center;">
        <h1>Categoria: <%= nomeCategoria %></h1>
        <a href="/" class="button" style="text-decoration: none;">Ver Todos os Produtos</a>
    </div>

    <% if (locals.produtos && produtos.length > 0) { %>
        <div class="div-lista-produtos">
            <% for (const produto of produtos) { %>
                <div class="produto">
                    <img src="<%= produto.imagem %>" alt="<%= produto.nome %>">
                    <span class="nome font-large"><%= produto.nome %></span>
                    <% if (produto.categoria) { %>
                        <span class="font-small" style="color: var(--accent);"><%= produto.categoria %></span>
                    <% } %>
                    <span class="font-medium">R$<%= produto.preco.toFixed(2) %></span>

                    <div style="display: flex; flex-direction: row; gap: 16px; justify-content: space-between; align-items: center; margin-top: 16px;">
                        <a class="button icon-button width100" href="/produto/<%= produto.id %>">
                            <span class="material-symbols-outlined">shoppingmode</span>
                            Ver Produto
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48px; gap: 16px;">
            <span class="material-symbols-outlined" style="font-size: 64px; color: var(--text);">search_off</span>
            <span class="font-large">Nenhum produto encontrado nesta categoria.</span>
            <a href="/" class="button">Voltar para o início</a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
