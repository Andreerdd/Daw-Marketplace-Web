<%- include('partials/header') %>

<div style="display: flex; flex-direction: column; gap: 8px; align-self: center;">
    <% if(locals.isVendor) { %>
        <div class="container perfil-abas" style="width: fit-content; flex-direction: row; min-width: 640px; width: 70vw; gap: 64px;">
            <a href="#dados"><span class="material-symbols-outlined">store</span>Dados da Loja</a>
            <a href="#produtos"><span class="material-symbols-outlined">manufacturing</span>Produtos</a>
            <a href="/dashboard"><span class="material-symbols-outlined">shopping_basket</span>Loja</a>
        </div>
        <div class="container" style="min-width: 640px; width: 70vw; height: 80vh;">
            <a class="botao-deslogar" href="/logout">sair</a>
            <h1><%= locals.user.username %></h1>
            
            <section class="perfil-section" id="dados">
                <h4>Conta</h4>
                <form method="post" action="/atualizar-cadastro" class="vendedor-verificado">
                    <label>
                        E-mail
                        <input type="text" value="<%= locals.user.email %>" class="input" disabled>
                    </label>
                    <label>
                        Nome
                        <input name="username" type="text" value="<%= locals.user.username %>" placeholder="" class="input" autocomplete="off" required>
                    </label>
                    <button type="submit" class="button">Salvar</button>
                </form>
            </section>
                <section class="perfil-section" id="produtos">
                    <h4>Produtos</h4>
                    <div class="div-lista-produtos">
                        <% for(let i = 0; i < 10; i++) { %>
                        <div class="produto">
                            <img src="https://i.scdn.co/image/ab67616d00001e02a0d9fa7e0467ea67fd7de2bb" alt="Foto do produto">
                            <span class="nome font-large">Nome super legal e bem grande blz sabrina carpenter</span>
                            
                            <div style="display: flex; flex-direction: row; gap: 16px; justify-content: space-between; align-items: center; margin-top: 16px;">
                                <span class="font-medium">R$<%= 67 * i * i %>,67 </span>
                                <button class="button icon-button ver-produto-btn">
                                    <span class="material-symbols-outlined">shoppingmode</span>
                                    Ver Produto
                                </button>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <button class="button icon-button">
                        <span class="material-symbols-outlined">add</span>
                        Novo Produto
                    </button>
                </section>
            </section>
        </div>
    <% } else { %>
        <div class="container">
            <h1>Perfil de vendedor não encontrado!</h1>
            <span>Parece que você ainda não realizou o cadastro de vendedor ainda!</span>
            <a href="cadastro-vendedor" class="button">Cadastre sua loja aqui!</a>
        </div>
    <% } %>
</div>

    
<%- include('partials/footer') %>