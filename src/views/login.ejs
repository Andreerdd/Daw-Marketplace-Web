<%- include('partials/header') %>

<div class="container" style="min-width: 480px; width: 50vw;">
    <form method="post" action="/login">
        <h1>Acessar conta</h1>
        <label>
            E-mail
            <input name="email" type="text" placeholder="" class="input" autocomplete="off" required>
        </label>
        <label>
            Senha
            <input name="password" type="password" placeholder="" class="input" autocomplete="off" required
                   minlength="6">
        </label>

        <a href="/cadastro" class="font-small font-underline" style="text-align: center;">Não tem uma conta? Crie
            agora!</a>

        <button type="submit" class="button">Entrar</button>
    </form>
    <% if(locals.mensagem) { %>
    <span class="mensagem-erro"><%= mensagem %></span>
    <% } %>
</div>

<%- include('partials/footer') %>