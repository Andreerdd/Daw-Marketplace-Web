<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Mercadinho</title>
    <link rel="stylesheet" href="./style.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
</head>
<body>
    <div class="header">
        <div class="header-left">
            <a class="mercadinho-logo" href="/"><span class="material-symbols-outlined" style="font-weight: 1000">sell</span>mercadinho</a>
        </div>
        <div class="header-right">
            <div class="searchbar">
                <span class="material-symbols-outlined" style="font-weight: 1000">search</span>
                <input type="text">
            </div>

            <div>
                <% if (username) { %>
                    <a id="usuario" href="/logout" class="a">sair (<%= username %>)</a>
                <% } else { %>
                    <a id="usuario" href="/login" class="a">login</a>
                <% } %>
            </div>
        </div>
    </div>
