<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Jueguitos</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
</head>
<body>
    <div class="header">
        <div class="header-left">
            <a class="a jueguitos-logo" href="/"><span class="icone-logo material-symbols-outlined" style="font-weight: 1000">playing_cards</span>jueguitos</a>
        
            <div class="categoria-header" tabindex="0" role="button" aria-haspopup="true" aria-expanded="false">
                <span>Categorias</span>
                <div class="categoria-header-menu" style="z-index: 100">
                    <a href="/categoria/jogos-de-cartas">Jogos de Cartas</a>
                    <a href="/categoria/jogos-de-tabuleiro">Jogos de Tabuleiro</a>
                    <a href="/categoria/outros">Outros</a>
                </div>
            </div>
        </div>
        <div class="header-right">
            <div class="searchbar">
                <span class="material-symbols-outlined" style="font-weight: 1000">search</span>
                <form method="post" action="/pesquisa" aria-label="Pesquisar produtos">
                    <label for="search-input" class="sr-only">Pesquisar</label>
                    <input id="search-input" type="text" name="search" aria-label="Pesquisar produtos">
                </form>
            </div>

            <% if (locals.username) { %>
                <a href="/chat" class="a">
                    <span class="material-symbols-outlined">chat</span>
                    Chat
                </a>
                <% } %>
            <a href="/carrinho" class="a" style="position: relative;">
                <span class="material-symbols-outlined">shopping_cart</span>
                <span class="carrinho-compras" id="carrinho-numero">-1</span>
            </a>

            <div>
                <% if (locals.username) { %>
                    <a id="usuario" href="/perfil#conta" class="a">
                        <span class="material-symbols-outlined">person</span>
                        <%= username %>
                    </a>
                <% } else { %>
                    <a id="usuario" href="/login" class="a">Acessar conta</a>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        let carrinho = JSON.parse(sessionStorage.getItem("carrinho")) || [];
        let tamanhoCarrinho = 0;

        carrinho.forEach(produto => {
            tamanhoCarrinho += produto.quantidade;
        });
        const carrinhoNumero = document.getElementById("carrinho-numero");
        if (carrinhoNumero) carrinhoNumero.textContent = tamanhoCarrinho;

        // Accessibility: toggle aria-expanded for categoria-header on keyboard focus and activation
        const categoriaHeader = document.querySelector('.categoria-header');
        const categoriaMenu = document.querySelector('.categoria-header-menu');
        if (categoriaHeader) {
            categoriaHeader.addEventListener('focusin', () => categoriaHeader.setAttribute('aria-expanded', 'true'));
            categoriaHeader.addEventListener('focusout', () => categoriaHeader.setAttribute('aria-expanded', 'false'));
            categoriaHeader.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    const expanded = categoriaHeader.getAttribute('aria-expanded') === 'true';
                    categoriaHeader.setAttribute('aria-expanded', String(!expanded));
                    if (!expanded) {
                        categoriaMenu?.querySelector('a')?.focus();
                    }
                }
            });
        }
    </script>