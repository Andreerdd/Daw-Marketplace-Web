<%- include('partials/header') %>

<div style="display: flex; flex-direction: row; gap: 8px; align-self: center;">
    <div class="container" style="max-width: 15vw; width: fit-content;">
        <a href="#conta"><span class="material-symbols-outlined">account_circle</span>Conta</a>
        <a href="#preferencias"><span class="material-symbols-outlined">manufacturing</span>Preferências</a>
        <a href="#vendedor"><span class="material-symbols-outlined">shopping_basket</span>Loja</a>
    </div>
    <div class="container" style="min-width: 500px; width: 30vw; height: 60vh;">
        <a class="botao-deslogar" href="/logout">
            <span class="material-symbols-outlined">logout</span>
            sair
        </a>
        <h1><%= locals.user.username %></h1>
        
        <section class="perfil-section" id="conta">
            <h4>Conta</h4>
            <form method="post" action="/atualizar-cadastro">
                <label>
                    E-mail
                    <input type="text" value="<%= locals.user.email %>" class="input" disabled>
                </label>
                <label>
                    Nome
                    <input name="username" type="text" value="<%= locals.user.username %>" placeholder="" class="input" autocomplete="off" required>
                </label>
                <button type="submit" class="button">Salvar</button>
            </form>
        </section>
        
        <section class="perfil-section" id="preferencias">
            <h4>Preferências</h4>
            <label>
                Tema Escuro
                <input type="checkbox" id="tema-escuro" checked>
                <span class="pista"></span>
            </label>
        </section>
        
        <section class="perfil-section" id="vendedor">
            <h4>Loja</h4>
            <div class="div-lista-produtos">
                <div class="produto">

                    <span class="nome">Nome super legal</span>
                    <span>Preço 67 67 67</span>
                </div>
            </div>

            <button class="button icon-button">
                <span class="material-symbols-outlined">add</span>
                Novo Produto
            </button>
        </section>
    </div>
</div>

<script>
const temaBotao = document.getElementById("tema-escuro");

if (localStorage.getItem('tema')) {
  temaBotao.checked = (localStorage.getItem('tema') === "escuro");
}
temaBotao.addEventListener('change', (event) => {
    let tema = event.target.checked ? "escuro" : "claro";
    document.documentElement.setAttribute('tema', tema);
    localStorage.setItem('tema', tema);
});
</script>
    
<%- include('partials/footer') %>