<!-- Página para ver um produto -->

<%- include('partials/header') %>
<div class="container" style="width: 90%;">
    <div class="topo-pagina-produto">
        <img src="<%= produto.imagem %>" alt="Foto do produto">


        <div class="produto-resumo">
            <div class="flex-column">
                <span class="nome font-extra-huge width100"><%= produto.nome %></span>

                <span class="font-medium">
                    De
                    <a class="display-inline">
                        <span class="font-medium font-bold font-underline clickable"><%= loja.nomeLoja %></span>
                    </a>
                </span>
                
                
            </div>
            <span class="font-medium width100"><%= produto.descricao %></span>
            <div class="container-inner">
                <span>
                    <span class="material-symbols-outlined">playing_cards</span>
                    <span><%= produto.cartas %></span>
                </span>
                <span>
                    <span class="material-symbols-outlined">chess_pawn</span>
                    <span><%= produto.pecas %></span>
                </span>
            </div>
            <div style="align-items: flex-start">

                <!-- Coloquei isso no meme -->
                <span class="font-large"
                      style="text-decoration: line-through">R$<%= (produto.preco * 1.67).toFixed(2) %>
                </span>
                <br>

                <span class="font-huge font-bold">R$<%= produto.preco.toFixed(2) %></span>
                <button class="button icon-button width100"
                        onclick="window.location.href='/comprar/<%= produto.id %>'">
                    <span class="material-symbols-outlined">shopping_cart</span>
                    Comprar
                </button>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
